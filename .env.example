# Copie para .env e configure os valores reais fora do controle de versão.
# Gere um segredo aleatório de pelo menos 32 bytes UTF-8.
ASPNETCORE_ENVIRONMENT=Development
CONDOMINIO_JWT_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-bytes

# ASP.NET Core lê variáveis de configuração com __ como separador de seção.
CondominioDatabaseSetting__ConnectionString=mongodb://usuario:senha@localhost:27017
CondominioDatabaseSetting__DatabaseName=Condominios

# Desenvolvimento aponta para o sandbox. Produção exige a URL de produção explícita.
JUNO_BASE_URL=https://sandbox.boletobancario.com
JUNO_RESOURCE_TOKEN=
JUNO_AUTHORIZATION=
JUNO_PLAN_ID=

# Reconciliação de pagamentos: mínimo 15 minutos, máximo 1440.
PAYMENT_CHECK_MINUTES=15

# SMTP para e-mails transacionais.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# URLs do ambiente de desenvolvimento. Em produção, use o host HTTPS real.
APP_BASE_URL=https://localhost:5001
ALLOWED_ORIGINS=https://localhost:3000
